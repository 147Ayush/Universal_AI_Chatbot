# Copy this file to .env and fill in real values.
# Never commit the real .env file (it's already in .gitignore).

APP_ENV=development
LOG_LEVEL=INFO

# --- LLM provider keys ---
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Default models per provider ---
OPENAI_DEFAULT_MODEL=gpt-4o-mini
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GEMINI_DEFAULT_MODEL=gemini-flash-lite-latest

# --- Database ---
# Plain psycopg-style URL (used as-is by LangGraph's Postgres checkpointer/store;
# db/session.py derives the SQLAlchemy "postgresql+asyncpg://" form from this).
# Matches docker-compose.yml's postgres service by default.
DATABASE_URL=postgresql://chatbot:chatbot_dev_password@localhost:5432/chatbot
